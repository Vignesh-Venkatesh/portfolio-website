---
import Title from "./Title.astro";
import SectionCorners from "./SectionCorners.astro";
---

<section id="education" class="grid-section">
    <SectionCorners seed="education" />
    <Title text="education" />
    <div class="flex flex-col gap-4">
        <!-- NYU -->
        <div class="flex flex-col gap-1 sm:flex-row sm:justify-between">
            <div>
                <h3 class="font-google font-semibold tracking-normal">New York University</h3>
                <p class="text-small text-muted">
                    M.S. Computer Science · Systems Concentration
                </p>
            </div>

            <div class="text-small text-muted sm:text-right">
                <p>New York, NY</p>
                <p>Sep 2025 – May 2027</p>
            </div>
        </div>

        <!-- Penn State -->
        <div class="flex flex-col gap-1 sm:flex-row sm:justify-between">
            <div>
                <h3 class="font-google font-semibold tracking-normal">The Pennsylvania State University</h3>
                <p class="text-small text-muted">B.S. Computer Science</p>
            </div>

            <div class="text-small text-muted sm:text-right">
                <p>State College, PA</p>
                <p>Aug 2021 – May 2025</p>
            </div>
        </div>
    </div>
</section>
