---
import { ArrowDown } from "@lucide/astro";
import SectionCorners from "./SectionCorners.astro";
type Project = {
    name: string;
    description: string;
    tech: string[];
    links: {
        label: string;
        url: string;
    }[];
};

type SmallProject = {
    name: string;
    description: string;
    links: {
        label: string;
        url: string;
    }[];
};

import Title from "./Title.astro";

const projects: Project[] = [
    {
        name: "DNS Resolver",
        description:
            "An iterative DNS resolver built from scratch in Go, implementing DNS packet parsing, nameserver referrals, CNAME traversal, and compression pointer handling.",
        tech: ["Go", "DNS", "Networking"],
        links: [
            {
                label: "GitHub",
                url: "https://github.com/Vignesh-Venkatesh/dns-resolver",
            },
            {
                label: "Writeup",
                url: "https://blog.vigneshvenkatesh.com/blog/dns-resolver-1/",
            },
        ],
    },
    {
        name: "Dynamic Memory Allocator",
        description:
            "A custom malloc/free-style memory allocator in C++, using segregated free lists, block splitting, and coalescing to manage heap memory.",
        tech: ["C/C++", "Memory Management", "Systems Programming"],
        links: [
            {
                label: "GitHub",
                url: "https://github.com/Vignesh-Venkatesh/DynamicMemoryAllocator",
            },
        ],
    },
    {
        name: "MovieBoxd",
        description:
            "A full-stack movie discovery and tracking platform featuring user authentication, ratings, reviews, and watchlists.",
        tech: ["React", "TypeScript", "Hono", "PostgreSQL"],
        links: [
            {
                label: "GitHub",
                url: "https://github.com/Vignesh-Venkatesh/MovieBoxd",
            },
            {
                label: "Demo",
                url: "https://movieboxd.vigneshvenkatesh.com/",
            },
        ],
    },
];

const moreProjects: SmallProject[] = [
    {
        name: "wordy",
        description: "A word count tool similar to Linux's wc.",
        links: [
            {
                label: "GitHub",
                url: "https://github.com/Vignesh-Venkatesh/wordy",
            },
        ],
    },
    {
        name: "movieboxd LLM users",
        description:
            "A tool to simulate user activity on my Letterboxd clone, MovieBoxd.",
        links: [
            {
                label: "GitHub",
                url: "https://github.com/Vignesh-Venkatesh/MovieBoxd-LLM-Users",
            },
            {
                label: "Blog",
                url: "https://blog.vigneshvenkatesh.com/blog/movieboxd-llm-users/",
            },
        ],
    },
];
---

<section id="projects" class="grid-section">
    <SectionCorners seed="projects" />
    <Title text="projects" />
    <!-- Featured Projects -->
    <div class="flex flex-col gap-8">
        {projects.map((project) => (
            <article class="flex flex-col gap-2">
                <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                    <h3 class="font-google tracking-normal font-semibold">
                        {project.name}
                    </h3>

                    <div class="flex flex-wrap items-center gap-3">
                        {project.links.map((link) => (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-google text-small tracking-normal text-muted transition-colors hover:text-accent"
                            >
                                {link.label}
                            </a>
                        ))}
                    </div>
                </div>

                <p class="text-body text-muted">{project.description}</p>

                <p class="text-small text-muted font-google tracking-normal">
                    {project.tech.join(" · ")}
                </p>
            </article>
        ))}
    </div>

    <!-- More Projects -->
    <div class="mt-10">
        <button
            id="more-projects-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="more-projects-panel"
            class="flex cursor-pointer items-center gap-3 font-google text-small tracking-normal text-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent aria-expanded:text-accent"
        >
            <span>more projects</span>
            <span
                id="more-projects-arrow"
                aria-hidden="true"
                class="inline-block transition-transform duration-300 motion-reduce:transition-none"
            >
                <ArrowDown size={14} strokeWidth={1.5} aria-hidden="true" />
            </span>
        </button>

        <div
            id="more-projects-panel"
            aria-labelledby="more-projects-toggle"
            inert
            class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out motion-reduce:transition-none"
        >
            <div class="min-h-0 overflow-hidden">
                <div class="mt-5 flex flex-col gap-5">
                    {moreProjects.map((project) => (
                        <article class="flex flex-col gap-2">
                            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
                                <h4 class="font-google tracking-normal font-semibold">
                                    {project.name}
                                </h4>

                                <div class="flex flex-wrap items-center gap-3">
                                    {project.links.map((link) => (
                                        <a
                                            href={link.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-google text-small tracking-normal text-muted transition-colors hover:text-accent"
                                        >
                                            {link.label}
                                        </a>
                                    ))}
                                </div>
                            </div>

                            <p class="text-small text-muted">{project.description}</p>
                        </article>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const moreProjectsToggle = document.querySelector<HTMLButtonElement>(
        "#more-projects-toggle",
    );
    const moreProjectsPanel = document.querySelector<HTMLDivElement>(
        "#more-projects-panel",
    );
    const moreProjectsArrow = document.querySelector<HTMLSpanElement>(
        "#more-projects-arrow",
    );

    moreProjectsToggle?.addEventListener("click", () => {
        const isExpanded = moreProjectsToggle.getAttribute("aria-expanded") === "true";
        moreProjectsToggle.setAttribute("aria-expanded", String(!isExpanded));
        moreProjectsPanel?.classList.toggle("grid-rows-[1fr]", !isExpanded);
        moreProjectsPanel?.classList.toggle("grid-rows-[0fr]", isExpanded);
        moreProjectsPanel?.classList.toggle("opacity-100", !isExpanded);
        moreProjectsPanel?.classList.toggle("opacity-0", isExpanded);
        if (moreProjectsPanel) moreProjectsPanel.inert = isExpanded;
        moreProjectsArrow?.classList.toggle("rotate-180", !isExpanded);
    });
</script>
