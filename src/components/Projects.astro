---
import HatchDivider from "../components/HatchDivider.astro";
import HighlightedText from "../components/HighlightedText.astro";
const featuredProjects = [
  {
    title: "DNS Resolver",
    description:[
      "Implemented an iterative DNS resolver in Go from scratch following RFC 1035, parsing binary DNS packets across a multi-hop resolution chain.",
      "Handled CNAME traversal, nameserver fallback when glue records were unavailable, compression pointer resolution, and circular pointer detection.",
      "Wrote unit tests for the query builder, serializer, and parser, identifying offset and packet truncation errors"
    ],
    tech: ["Go", "DNS", "Network Protocols", "Binary Serialization", "Unit Testing"],
    github: "https://github.com/Vignesh-Venkatesh/dns-resolver",
    live: null,
    blog: "https://blog.vigneshvenkatesh.com/blog/dns-resolver-1",
  },
  {
    title: "Dynamic Memory Allocator",
    description: [
      "Built a malloc/free-style dynamic memory allocator in C++, implementing custom heap allocation, deallocation, splitting, and block coalescing.",
      "Developed a segregated free-list structure that organized memory blocks by size class, improving allocation efficiency and reducing fragmentation.",
      "Enforced 16-byte alignment for allocated and free blocks while maintaining block metadata and heap consistency."
    ],
    tech: ["C++", "Memory Management", "Data Structures", "Systems Programming"],
    github: "https://github.com/Vignesh-Venkatesh/DynamicMemoryAllocator",
    live: null,
    blog: null,
  },
  {
    title: "MovieBoxd",
    description:[
      "Built a full-stack movie discovery and tracking platform supporting authentication, ratings, reviews, and user watchlists.",
      "Designed RESTful backend services using Hono and PostgreSQL to manage user, review, and movie-related data.",
      "Implemented authentication with Supabase Auth and integrated the TMDB API to retrieve real-time movie metadata, ratings, and cast information.",
    ],
    tech: ["React", "TypeScript", "Hono", "PostgreSQL", "Supabase", "REST APIs", "TMDb API"],
    github: "https://github.com/Vignesh-Venkatesh/MovieBoxd",
    live: "https://movieboxd.vigneshvenkatesh.com/",
    blog: null,
  },
];

const projectKeywords = [
  [
    ["iterative DNS resolver in Go", "RFC 1035"],
    ["CNAME traversal", "nameserver fallback", "compression pointer resolution"],
    ["dependency-free unit tests", "offset and packet truncation errors"],
  ],
  [
    ["malloc/free-style dynamic memory allocator in C++"],
    ["segregated free-list structure"],
    ["16-byte alignment"],
  ],
  [
    ["full-stack movie discovery and tracking platform"],
    ["RESTful backend services", "Hono and PostgreSQL"],
    ["Supabase Auth", "TMDB API"],
  ],
];

const otherProjects = [
  // {
  //   title: "vtop",
  //   description: "htop-like system monitor",
  //   github: "https://github.com/Vignesh-Venkatesh/vtop",
  //   live: null,
  //   blog: null
  // },
  {
    title: "wordy",
    description: "word count tool similar to Linux's wc.",
    github: "https://github.com/Vignesh-Venkatesh/wordy",
    live: null,
    blog: null,
  },
  {
    title: "movieboxd LLM users",
    description: "to simulate user activity on my LetterBoxd clone - 'MovieBoxd'.",
    github: "https://github.com/Vignesh-Venkatesh/MovieBoxd-LLM-Users",
    blog: "https://blog.vigneshvenkatesh.com/blog/movieboxd-llm-users",
    live: null
  },
];
---

<section
  class="scroll-mt-20 px-6 sm:px-8 py-6 lg:px-8 border-x border-separator/50 font-google"
  id="projects"
>
    <div class="flex items-center gap-3">
        <h1 class="font-bold text-tertiary text-xl">/projects</h1>
        <div class="flex-1 h-px bg-separator"></div>
    </div>

    <!-- Featured Projects -->
    <div class="mt-6 space-y-10">
    {featuredProjects.map((project,i) => (
        <>
        <div>
        <!-- title, links -->
        <div class="flex justify-between items-baseline">
            <h2 class="text-secondary font-semibold">
            {project.title}
            </h2>

            <div class="flex gap-3 text-tertiary text-sm">

                <!-- demo -->
                {
                  project.live && (
                    <a
                        href={project.live}
                        target="_blank"
                        class="hover:text-green transition-colors"
                    >
                        Demo
                    </a>
                  )
                }

                <!-- blog post -->
                {
                  project.blog && (
                    <a
                        href={project.blog}
                        target="_blank"
                        class="hover:text-green transition-colors"
                    >
                        Blog
                    </a>
                  )
                }

                <!-- github -->
                {
                  project.github && (
                    <a
                        href={project.github}
                        target="_blank"
                        class="hover:text-green transition-colors"
                    >
                        GitHub
                    </a>
                  )
                }
            </div>
        </div>

        <!-- description -->
        <div class="my-4">
            {project.description.map((pointer, pointerIndex) => (
                <div class="flex gap-2">
                    <div>•</div>
                    <p class="leading-relaxed text-justify text-sm text-secondary/90">
                        <HighlightedText
                            text={pointer}
                            keywords={projectKeywords[i]?.[pointerIndex] ?? []}
                        />
                    </p>
                </div>
            ))}
        </div>

        <!-- tech -->
        <p class="text-xs font-semibold text-tertiary mt-2">
            {project.tech.join(" · ")}
        </p>
        </div>

        <!-- rendering divider if not last -->
        {i !== featuredProjects.length - 1 && <HatchDivider />}
        </>
    ))}
    </div>


    <!-- Other Projects -->
    <div class="mt-10">
    <div class="flex items-center gap-3 mb-4">
        <h1 class="font-bold text-tertiary text-md">other-projects</h1>
        <div class="flex-1 h-px bg-separator"></div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 text-sm">
        {otherProjects.map((project) => (
          <div class="flex flex-col justify-between border-separator border-b-2 border-r-2 pr-2">
              <div>
                <p class="text-secondary font-semibold">{project.title}</p>
                <p class="my-2 text-justify text-sm text-secondary/90">{project.description}</p>
              </div>

              <!-- links -->
              <div class="flex gap-3 text-tertiary mt-4 mb-2 justify-end">
                  <!-- demo -->
                  {
                    project.live && (
                      <a
                          href={project.live}
                          target="_blank"
                          class="hover:text-green transition-colors"
                      >
                          Demo
                      </a>
                    )
                  }

                  <!-- blog post -->
                  {
                    project.blog && (
                      <a
                          href={project.blog}
                          target="_blank"
                          class="hover:text-green transition-colors"
                      >
                          Blog
                      </a>
                    )
                  }

                  <!-- github -->
                  {
                    project.github && (
                      <a
                          href={project.github}
                          target="_blank"
                          class="hover:text-green transition-colors"
                      >
                          GitHub
                      </a>
                    )
                  }
              </div>
          </div>

        ))}
    </div>
    </div>
</section>
