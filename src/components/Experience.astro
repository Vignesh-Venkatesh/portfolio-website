---
import HatchDivider from "../components/HatchDivider.astro";
import HighlightedText from "../components/HighlightedText.astro";
const experiences = [
    {
        title: "Software Engineering Intern",
        company: "MiraPhoto",
        date: "June 2026 – Aug 2026",
        location: "New York City, NY",
        bullets: [
          "Built a model feed feature using Expo, React Native, and TypeScript, implementing image upload workflows and responsive feed rendering.",
          "Designed and implemented the backend architecture supporting model uploads, image storage, retrieval, and display.",
          "Reduced image loading latency by approximately 85% through optimized image delivery and application data flows.",
          "Investigated and methodically resolved high-priority P0 production issues, improving application stability and release quality.",
          "Bootstrapped a CI/CD pipeline using YAML workflows and GitHub Actions, automating builds and deployments through a self-hosted Mac Mini runner."
        ],
    },
    {
        title: "Distributed Control Systems Intern",
        company: "Yokogawa Electric",
        date: "May 2024 – June 2024",
        location: "Abu Dhabi, U.A.E",
        bullets: [
            "Learned SEBOL, Yokogawa’s proprietary C-based control language, and began developing production code within one week.",
            "Developed alarm suppression logic, a step function, and a moving average function block for industrial plant monitoring.",
            "Supported project engineering workflows using GitHub Issues, GitHub Actions, and project planning tools to prioritize bugs and coordinate work across a 3–5 member engineering team.",
        ],
    },
    {
        title: "Digital Design Course Learning Assistant",
        company: "The Pennsylvania State University",
        date: "Aug 2023 – May 2025",
        location: "State College, PA",
        bullets: [
            "Moderated course discussions, provided technical feedback to students, graded 200+ assignments weekly, and collaborated with faculty and teaching assistants to develop digital design course materials.",
        ],
    },
];

const experienceKeywords = [
    [
        ["model feed feature", "Expo, React Native, and TypeScript"],
        ["backend architecture", "model uploads", "image storage", "retrieval", "display"],
        ["image loading latency by approximately 85%", "optimized image delivery"],
        ["high-priority P0 production issues"],
        ["CI/CD pipeline", "YAML workflows and GitHub Actions", "self-hosted Mac Mini runner"],
    ],
    [
        ["SEBOL", "C-based control language", "production code within one week"],
        ["alarm suppression logic", "step function", "moving average function block"],
        ["GitHub Issues, GitHub Actions, and project planning tools", "3–5 member engineering team"],
    ],
    [["graded 200+ assignments weekly", "digital design course materials"]],
];
---

<section
    class="scroll-mt-20 px-6 sm:px-8 py-4 lg:px-8 border-x-separator/50 border-x font-google"
    id="experience"
>
    <div class="flex items-center gap-3">
      <h1 class="font-bold text-tertiary text-xl">/experience</h1>
      <div class="flex-1 h-px bg-separator"></div>
    </div>

    <div class="flex flex-col">
        {
          experiences.map((exp, i) => (
            <>
              <div class="my-4">
                <!-- title, company, location, date -->
                <div class="flex justify-between items-baseline">
                  <div>
                    <p class="text-md font-semibold text-secondary">
                      {exp.title}
                    </p>
                    <p class="text-xs text-tertiary">
                      <span class="italic">at</span>, {exp.company}
                    </p>

                    <div class="block
                    sm:hidden text-xs text-tertiary">
                      <p>{exp.location}</p>
                      <p>{exp.date}</p>
                    </div>
                  </div>

                  <div class="hidden sm:block text-sm text-end text-tertiary">
                    <p class="text-xs">{exp.date}</p>
                    <p class="text-xs">{exp.location}</p>
                  </div>
                </div>

                <!-- bullets -->
                <div class="mt-4">
                  {exp.bullets.map((bullet, bulletIndex) => (
                    <div class="flex gap-2">
                      <div>•</div>
                      <div class="leading-relaxed text-justify text-sm text-secondary/90">
                        <p>
                          <HighlightedText
                            text={bullet}
                            keywords={experienceKeywords[i]?.[bulletIndex] ?? []}
                          />
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- rendering divider if not last -->
              {i !== experiences.length - 1 && <HatchDivider />}
            </>
          ))
        }
    </div>
</section>
