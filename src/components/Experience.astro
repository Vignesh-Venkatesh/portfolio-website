---
import SectionCorners from "./SectionCorners.astro";
type Experience = {
    company: string;
    role: string;
    location: string;
    period: string;
    description: string;
};

import Title from "./Title.astro";

const experiences: Experience[] = [
    {
        company: "MiraPhoto",
        role: "Software Engineering Intern",
        location: "New York, NY",
        period: "Jun 2026 – Aug 2026",
        description:
            "Worked on mobile and backend features, optimized image delivery to reduce loading latency by approximately 85%, and automated deployment workflows.",
    },
    {
        company: "Yokogawa Electric",
        role: "Distributed Control Systems Intern",
        location: "Abu Dhabi, UAE",
        period: "May 2024 – Jun 2024",
        description:
            "Developed industrial control logic for monitoring systems, including alarm suppression and signal processing functions.",
    },
];
---

<section id="experience" class="grid-section">
    <SectionCorners seed="experience" showTop={false} />
    <Title text="experience" />
    <div class="flex flex-col gap-6">
        {experiences.map((experience) => (
            <article class="flex flex-col gap-2">
                <div class="flex flex-col gap-1 sm:flex-row sm:justify-between">
                    <div>
                        <h3 class="font-semibold font-google tracking-normal">
                            {experience.company}
                        </h3>
                        <p class="text-small text-muted">{experience.role}</p>
                    </div>

                    <div class="text-small text-muted sm:text-right">
                        <p>{experience.location}</p>
                        <p>{experience.period}</p>
                    </div>
                </div>

                <p class="text-body text-muted">{experience.description}</p>
            </article>
        ))}
    </div>
</section>
