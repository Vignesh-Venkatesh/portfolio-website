---
interface Props {
    seed: string;
    verticalOverflow?: boolean;
    showTop?: boolean;
}

const { seed, verticalOverflow = true, showTop = true } = Astro.props;
type Block = { x: number; y: number; filled: boolean };

function cluster(corner: "top" | "bottom"): Block[] {
    let state = 2166136261;
    for (const char of `${seed}:${corner}`) state = Math.imul(state ^ char.charCodeAt(0), 16777619);
    const random = () => {
        state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
        return state / 4294967296;
    };
    // Grow a single connected silhouette outward from the wall intersection.
    const cells = [{ x: 0, y: 0 }];
    const occupied = new Set(["0,0"]);
    while (cells.length < 8) {
        const candidates = new Map<string, { x: number; y: number }>();
        for (const cell of cells) {
            for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {
                const x = cell.x + dx;
                const y = cell.y + dy;
                const key = `${x},${y}`;
                if (x >= 0 && x < 5 && y >= 0 && y < 5 && !occupied.has(key)) candidates.set(key, { x, y });
            }
        }
        const options = [...candidates.values()];
        const next = options[Math.floor(random() * options.length)];
        occupied.add(`${next.x},${next.y}`);
        cells.push(next);
    }
    return cells.map(({ x, y }) => ({
        x: corner === "top" ? 4 - x : x,
        y: corner === "bottom" ? 4 - y : y,
        filled: random() < 0.25,
    }));
}

const topBlocks = cluster("top");
const bottomBlocks = cluster("bottom");
// Add whole exterior cells joined to cells already touching each side wall.
topBlocks.push(...topBlocks.filter(({ x }) => x === 4).slice(0, 2).map((block) => ({ ...block, x: 5 })));
bottomBlocks.push(...bottomBlocks.filter(({ x }) => x === 0).slice(0, 2).map((block) => ({ ...block, x: -1 })));
if (verticalOverflow) {
    // Only exterior columns cross the horizontal section rules.
    topBlocks.push({ x: 5, y: -1, filled: false });
    bottomBlocks.push({ x: -1, y: 5, filled: false });
}
---

<div class="section-corners" aria-hidden="true">
    {showTop && <svg class="corner-top" width="144" height="120" viewBox="0 0 144 120" fill="none">
        {topBlocks.map(({ x, y, filled }) => (
            <rect class:list={{ "exterior-block": x < 0 || x >= 5 || y < 0 || y >= 5 }} x={x * 24} y={y * 24} width="24" height="24" opacity={Math.min(1, Math.max(0.18, 1 - (5 - x + y) * 0.17))} fill={filled ? "currentColor" : "none"} fill-opacity="0.12" stroke="currentColor" stroke-width="0.75" />
        ))}
    </svg>}
    <svg class="corner-bottom" width="144" height="120" viewBox="-24 0 144 120" fill="none">
        {bottomBlocks.map(({ x, y, filled }) => (
            <rect class:list={{ "exterior-block": x < 0 || x >= 5 || y < 0 || y >= 5 }} x={x * 24} y={y * 24} width="24" height="24" opacity={Math.min(1, Math.max(0.18, 1 - (x + 5 - y) * 0.17))} fill={filled ? "currentColor" : "none"} fill-opacity="0.1" stroke="currentColor" stroke-width="0.75" />
        ))}
    </svg>
</div>

<style>
    .section-corners {
        --corner-cell: 20.8px;
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: visible;
        pointer-events: none;
        color: var(--color-foreground);
    }

    svg {
        position: absolute;
        overflow: visible;
        width: calc(var(--corner-cell) * 6);
        height: calc(var(--corner-cell) * 5);
        opacity: 0.22;
    }

    .corner-top {
        top: 0;
        right: calc(-1 * var(--corner-cell));
    }

    .corner-bottom {
        bottom: 0;
        left: calc(-1 * var(--corner-cell));
    }

    @media (max-width: 39.999rem) {
        .exterior-block {
            display: none;
        }

        .section-corners {
            --corner-cell: 17.6px;
            left: -1.25rem;
            right: -1.25rem;
            overflow: hidden;
        }

        svg {
            opacity: 0.16;
        }
    }
</style>
