---
interface Props {
    fullscreen?: boolean;
}
const { fullscreen = false } = Astro.props;
---

<canvas data-landscape data-fullscreen={fullscreen ? "true" : undefined} aria-hidden="true"></canvas>

<style>
    canvas {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
</style>

<script src="../scripts/dithered-landscape.ts"></script>
