---
import Title from "./Title.astro";
import SectionCorners from "./SectionCorners.astro";
---

<section id="skills" class="grid-section">
    <SectionCorners seed="skills" verticalOverflow={false} />
    <Title text="skills" />
    <dl class="space-y-3">
        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="text-small text-muted">languages</dt>
            <dd class="text-body">
                TypeScript · JavaScript · Python · Go · Rust · C/C++ · SQL
            </dd>
        </div>

        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="text-small text-muted">backend</dt>
            <dd class="text-body">Node.js · Bun · Hono · Express</dd>
        </div>

        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="text-small text-muted">frontend</dt>
            <dd class="text-body">
                React · React Native · Expo · Astro · Tailwind CSS
            </dd>
        </div>

        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="text-small text-muted">databases</dt>
            <dd class="text-body">PostgreSQL · SQLite · MongoDB</dd>
        </div>

        <div class="grid grid-cols-1 gap-1 sm:grid-cols-[7rem_1fr] sm:gap-4">
            <dt class="text-small text-muted">tools</dt>
            <dd class="text-body">Git · Docker · Linux · Supabase</dd>
        </div>
    </dl>
</section>
